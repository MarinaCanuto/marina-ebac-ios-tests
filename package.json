{
  "name": "ebac-store-mobile-tests",
  "type": "module",
  "devDependencies": {
    "@wdio/allure-reporter": "^8.24.12",
    "@wdio/cli": "^8.26.1",
    "@wdio/local-runner": "^8.26.1",
    "@wdio/mocha-framework": "^8.24.12",
    "@wdio/spec-reporter": "^8.24.12",
    "appium-uiautomator2-driver": "^2.34.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "test": "wdio run ./config/wdio.conf.js",
    "test:login": "wdio run ./config/wdio.conf.js --suite login",
    "test:product": "wdio run ./config/wdio.conf.js --suite product",
    "test:search": "wdio run ./config/wdio.conf.js --suite search",
    "test:account": "wdio run ./config/wdio.conf.js --spec ./test/specs/account.test.js",
    "test:searchios": "wdio run ./config/wdio.conf.js --spec ./test/specs/search-ios.test.js",
    "test:smoke": "wdio run ./config/wdio.conf.js --spec ./test/specs/smoke-ios.test.js",
    "test:productios": "wdio run ./config/wdio.conf.js --spec ./test/specs/product-ios.test.js",
    "test:cartios": "wdio run ./config/wdio.conf.js --spec ./test/specs/cart-ios.test.js",
    "test:checkoutios": "wdio run ./config/wdio.conf.js --spec ./test/specs/checkout-ios.test.js",
    "test:inspect": "wdio run ./config/wdio.conf.js --spec ./test/specs/inspect-ios.test.js"
  },
  "dependencies": {
    "allure-commandline": "^2.25.0",
    "dotenv": "^16.4.4"
  }
}